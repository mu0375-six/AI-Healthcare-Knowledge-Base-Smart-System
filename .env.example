# 配置模板。使用前复制一份并填入自己的值：
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux / macOS)
# .env 不会进入版本库，请勿把真实密钥提交上来。

# ---- MySQL ----
# 与 docker-compose 启动的 mysql 容器共用，首次启动时按这里的值建库建用户。
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=healthkb
MYSQL_USER=healthkb
MYSQL_PASSWORD=change-me

# ---- 登录令牌签名密钥 ----
# HS256 签名用，请自行换成足够长的随机串；修改后已签发的 token 全部失效。
APP_JWT_SECRET=change-me-to-a-long-random-string

# ---- 对话大模型（DeepSeek）----
# 不配置 API Key 时问答自动回退模板回答，其余功能不受影响。
APP_LLM_BASE_URL=https://api.deepseek.com
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-v4-flash-vision-exp

# ---- 医学知识向量化（可选，不配则回退哈希向量）----
APP_EMBEDDING_BASE_URL=
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=BAAI/bge-m3
