# 配置模板。使用前复制一份并填入自己的值：
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Linux / macOS)
# .env 不会进入版本库，请勿把真实密钥提交上来。

# ---- MySQL ----
# 与 docker-compose 启动的 mysql 容器共用，首次启动时按这里的值建库建用户。
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=healthkb
MYSQL_USER=healthkb
MYSQL_PASSWORD=change-me

# ---- 登录令牌签名密钥 ----
# HS256 签名用，请自行换成足够长的随机串；修改后已签发的 token 全部失效。
APP_JWT_SECRET=change-me-to-a-long-random-string

# ---- 对话大模型（DeepSeek）----
# 不配置 API Key 时问答自动回退模板回答，其余功能不受影响。
APP_LLM_BASE_URL=https://api.deepseek.com
APP_LLM_API_KEY=
APP_LLM_MODEL=deepseek-v4-flash-vision-exp

# ---- 接口限流（可选）----
# 登录/注册按客户端 IP 限流（次/分钟），防止密码爆破；问答/报告/健康建议按用户限流。
# 0 或负数表示不限流。窗口默认 60 秒，可用 APP_RATE_LIMIT_WINDOW_SECONDS 统一调整。
APP_RATE_LIMIT_AUTH=10
#APP_RATE_LIMIT_WINDOW_SECONDS=60

# ---- 上传限额（可选）----
# 报告上传单文件上限（同时驱动后端解析器校验与 multipart 配置），默认 10MB。
#APP_UPLOAD_MAX_BYTES=10MB
# 单次请求总上限，默认比文件上限大 2MB 以留出表单开销。
#APP_UPLOAD_MAX_REQUEST_BYTES=12MB

# ---- 演示账号开关（可选）----
# 默认创建 admin / user 两个演示账号；对外部署或安全评审场景可关闭。
#APP_SEED_DEMO_ACCOUNTS=false

# ---- 允许的前端源（可选，逗号分隔多值）----
# 仅跨域直连（非 vite 代理）时生效；容器部署时前端同源可不动。
#APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 前端开发代理（可选）----
# 仅本地开发生效：npm run dev 时 /api 代理到的后端地址。
#VITE_PROXY_TARGET=http://localhost:8080

# ---- 启动重建（可选）----
# 启动时 DB 与向量库条数一致就跳过重新 embedding（只回灌内存备份）。
# 若更新了知识内容但条数恰好没变，置 true 强制全量重建一次。
APP_KB_FORCE_REINDEX=false

# ---- 医学知识向量化（可选，不配则回退哈希向量）----
APP_EMBEDDING_BASE_URL=
APP_EMBEDDING_API_KEY=
APP_EMBEDDING_MODEL=BAAI/bge-m3

# ---- 高德地图（可选）----
# 导诊页「附近医疗资源」的周边检索与地理编码。个人开发者 key 免费申请：
# https://lbs.amap.com/ 。不配置时该功能降级为科室就医建议文字，不影响导诊本身。
AMAP_KEY=

# ---- 首页健康新闻（可选）----
# 启动后与每 6 小时爬一次世界卫生组织中文新闻室；断网时自动落库内置科普快照。
# NEWS_ENABLED=false 可整体关闭；NEWS_ALLOW_NETWORK=false 强制走内置快照（离线演示用）。
#APP_NEWS_ENABLED=false
#APP_NEWS_ALLOW_NETWORK=false
#APP_NEWS_IMAGE_DIR=./data/news-images

